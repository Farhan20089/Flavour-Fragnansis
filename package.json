{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npx prisma generate && npx prisma migrate deploy",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npx prisma generate && next build",
    "preview": "next start",
    "prestart": "npx prisma generate && npx prisma migrate deploy",
    "start": "next start --hostname 0.0.0.0",
    "db:migrate": "npx prisma migrate deploy",
    "db:seed": "npx esbuild src/lib/seed-db.ts --bundle --platform=node --format=esm --packages=external --loader:.jpg=dataurl --outfile=dist/seed.mjs && node -e \"import('./dist/seed.mjs').then(m => m.seedDatabase()).catch(console.error);\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "deepmerge-ts": "^8.0.0"
  }
}
