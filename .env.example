# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_SITE_URL="https://example.com"

# AUTHENTICATION & SECURITY
AUTH_SECRET="replace-with-64-char-cryptographic-hmac-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"
DATABASE_URL="file:./dev.db"
# Comma-separated list of emails allowed into the Admin Portal (Google / email OTP). Empty = nobody is admin.
ADMIN_SEED_EMAIL="your-email@gmail.com"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Auth.js email OTP (Gmail App Password required)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="your-email@gmail.com"

# SMTP EMAIL NOTIFICATIONS
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD_HERE"
ADMIN_NOTIFICATION_EMAIL="your-email@gmail.com"

# CLOUD STORAGE ABSTRACTION (S3 / GCS / Local Fallback)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="sk-group-of-company-media-assets"
STORAGE_REGION="eu-central-1"
STORAGE_ACCESS_KEY_ID="YOUR_STORAGE_ACCESS_KEY_ID"
STORAGE_SECRET_ACCESS_KEY="YOUR_STORAGE_SECRET_ACCESS_KEY"

# ANALYTICS
ANALYTICS_ID="G-XXXXXXXXXX"

DATABASE_URL="file:./dev.db"

VITE_CONFIG_NATIVE_IGNORE_WARNING=true